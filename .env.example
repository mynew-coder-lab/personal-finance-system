# Application Configuration
APP_NAME="Personal Finance Intelligence System"
APP_ENV="development"
DEBUG=true
API_V1_STR="/api/v1"

# Security (Change in production!)
SECRET_KEY="super-secret-key-for-development-change-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL via Docker Compose)
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/finance_db"

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:5173","http://127.0.0.1:8000"]
